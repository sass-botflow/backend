# EasyPanel deploy — NO npm ci on VPS (downloads pre-built runtime from GitHub CI)
# EasyPanel → Source → GitHub → sass-botflow/backend → main → /Dockerfile.easypanel → port 8000
#
# Build on VPS: ~1-2 min (curl 97MB bundle). Previous version ran npm ci and hung 2+ hours.
FROM node:22-slim AS base
LABEL org.opencontainers.image.source=https://github.com/sass-botflow/backend
LABEL org.opencontainers.image.description="BotFlow API — EasyPanel zero-build deploy"
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*

FROM base AS runner
ARG BUILD_COMMIT=unknown
ARG RUNTIME_RELEASE_TAG=runtime-bundle
ARG CACHEBUST=1
ENV NODE_ENV=production
ENV BUILD_COMMIT=$BUILD_COMMIT

RUN echo "==> EasyPanel build CACHEBUST=${CACHEBUST} commit=${BUILD_COMMIT}" \
  && echo "==> [1/2] download runtime-full (~97MB, max 5 min)..." \
  && curl -fsSL --connect-timeout 30 --max-time 300 --retry 3 --retry-delay 5 \
    "https://github.com/sass-botflow/backend/releases/download/${RUNTIME_RELEASE_TAG}/runtime-full.tar.gz" \
    -o /tmp/runtime-full.tar.gz \
  && tar -xzf /tmp/runtime-full.tar.gz -C /app \
  && rm /tmp/runtime-full.tar.gz \
  && test -f /app/dist/main.js \
  && test -f /app/node_modules/.bin/prisma \
  && echo "==> [1/2] done"

RUN echo "==> [2/2] validate dist..." \
  && node -e "\
  const fs=require('fs');\
  const p='dist/modules/instagram/guards/instagram-auth.guard.js';\
  const s=fs.readFileSync(p,'utf8');\
  if (s.includes(\"require(\\\"./meta.config\\\")\")) {\
    console.error('FATAL: runtime bundle has broken instagram import');\
    process.exit(1);\
  }\
  console.log('runtime OK:', p, '| build-id:', fs.readFileSync('build-id.txt','utf8').trim());\
" \
  && echo "==> [2/2] done — image ready"

COPY docker-entrypoint.sh ./
RUN chmod +x docker-entrypoint.sh

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:' + (process.env.PORT || 8000) + '/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

ENTRYPOINT ["./docker-entrypoint.sh"]
