# EasyPanel low-RAM deploy — NO nest build on VPS (uses CI pre-built bundle)
# EasyPanel → Source → GitHub → Dockerfile path: /Dockerfile.easypanel
FROM node:22-slim AS base
LABEL org.opencontainers.image.source=https://github.com/sass-botflow/backend
LABEL org.opencontainers.image.description="BotFlow API — EasyPanel low-RAM build"
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*

FROM base AS runner
ARG BUILD_COMMIT=unknown
ARG RUNTIME_BUNDLE_TAG=runtime-bundle
ARG CACHEBUST=1
ENV NODE_ENV=production
ENV BUILD_COMMIT=$BUILD_COMMIT
# Prevent npm/curl from hanging indefinitely on slow VPS networks
ENV npm_config_fetch_timeout=120000
ENV npm_config_fetch_retries=3

COPY package.json package-lock.json ./
COPY prisma ./prisma

RUN echo "==> [1/3] npm ci (max ~3 min) CACHEBUST=${CACHEBUST} commit=${BUILD_COMMIT}" \
  && npm ci --omit=dev --no-audit --no-fund --progress=false \
  && npx prisma generate \
  && echo "==> [1/3] done"

RUN echo "==> [2/3] download runtime-bundle (max 3 min)..." \
  && curl -fsSL --connect-timeout 30 --max-time 180 --retry 3 --retry-delay 5 \
    "https://github.com/sass-botflow/backend/releases/download/${RUNTIME_BUNDLE_TAG}/runtime-bundle.tar.gz" \
    -o /tmp/runtime-bundle.tar.gz \
  && tar -xzf /tmp/runtime-bundle.tar.gz -C /app \
  && rm /tmp/runtime-bundle.tar.gz \
  && test -f /app/dist/main.js \
  && echo "==> [2/3] done"

# Fail the Docker build (not runtime 502) if CI bundle is stale/broken
RUN echo "==> [3/3] validate dist..." \
  && node -e "\
  const fs=require('fs');\
  const p='dist/modules/instagram/guards/instagram-auth.guard.js';\
  const s=fs.readFileSync(p,'utf8');\
  if (s.includes(\"require(\\\"./meta.config\\\")\")) {\
    console.error('FATAL: runtime-bundle has broken instagram import. Merge main + wait for docker-publish.yml');\
    process.exit(1);\
  }\
  console.log('runtime bundle OK:', p);\
" \
  && echo "==> [3/3] done — image ready"

COPY docker-entrypoint.sh ./
RUN chmod +x docker-entrypoint.sh

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:' + (process.env.PORT || 8000) + '/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

ENTRYPOINT ["./docker-entrypoint.sh"]
