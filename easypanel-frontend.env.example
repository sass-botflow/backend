# EasyPanel → sass-botflow → frontend → Environment
# COPY-PASTE (fix site 500). Get keys from https://dashboard.clerk.com → API Keys

NODE_ENV=production
PORT=3000

# REQUIRED — site 500 if missing or wrong
CLERK_SECRET_KEY=sk_live_REPLACE_ME
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME

# MUST match backend JWT_SECRET exactly
JWT_SECRET=BotflowJwtSecret2026Min32CharsLong!!

NEXT_PUBLIC_APP_URL=https://www.botflow.ink
NEXT_PUBLIC_API_URL=https://api.botflow.ink

# WhatsApp (Evolution)
EVOLUTION_API_URL=http://sass-botflow_botflow-evolution:8080
EVOLUTION_API_KEY=BotflowEvolution2026SecureKey!

# Clerk URLs (optional if defaults work)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding
